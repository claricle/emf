#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: script/check_native_package --directory DIR [--revision SHA]
#
# Opens every .gem in DIR and checks its contents against emf.gemspec and,
# for platform gems, against the generated lib/emf/native/platforms.json and
# provenance.json. With --revision SHA the recorded git revision must equal it;
# source gems must also match the checkout's Cargo.lock and crate version.
# Prints one line per violation and exits 1 if there is any.

require "digest"
require "json"
require "optparse"
require "rubygems/package"
require "tmpdir"

load File.expand_path("build_source_release_gem", __dir__)

class NativePackageChecker
  ROOT = File.expand_path("..", __dir__)
  NATIVE_DIR = "lib/emf/native"
  LIBRARY = /\.(so|dylib|dll)\z/
  RUST_FILE = %r{(\A|/)(Cargo\.(toml|lock)|[^/]+\.rs)\z}

  PROVENANCE_FIELDS = %w[platform target library_sha256 rustc cargo cargo_lock_sha256 crate_version revision
                         gem_version].freeze
  SHA256 = /\A\h{64}\z/
  REVISION = /\A\h{40}\z/

  def initialize(directory, revision: nil)
    abort "--revision must be a full 40-character lowercase git SHA" if revision && !revision.match?(/\A[0-9a-f]{40}\z/)

    @directory = directory
    @revision = revision
    @source_files = Dir.chdir(ROOT) { Gem::Specification.load("emf.gemspec").files }
  end

  def violations
    gems = Dir.glob(File.join(@directory, "*.gem"))
    return ["no .gem files in #{@directory}"] if gems.empty?

    gems.flat_map { |path| check(path) }
  end

  private

  def check(path)
    package = Gem::Package.new(path)
    Dir.mktmpdir("emf-check") do |dir|
      package.extract_files(dir)
      problems = problems_for(package.spec, package.contents, dir)
      problems.map { |problem| "#{File.basename(path)}: #{problem}" }
    end
  end

  def problems_for(spec, contents, dir)
    problems = missing_source_files(contents)
    return problems + source_problems(spec, contents) if spec.platform.to_s == "ruby"

    problems + native_problems(spec, contents, dir)
  end

  def missing_source_files(contents)
    (@source_files - contents).map { |file| "missing #{file} listed by emf.gemspec" }
  end

  def source_problems(spec, contents)
    problems = contents.grep(LIBRARY).map { |file| "source gem contains native library #{file}" }
    problems += contents.grep(RUST_FILE).map { |file| "source gem contains Rust file #{file}" }
    problems << "source gem declares extensions" unless spec.extensions.empty?
    problems << "source gem depends on fiddle" if spec.runtime_dependencies.any? { |d| d.name == "fiddle" }
    problems += SourceReleaseGemBuilder.problems(spec, @revision) if @revision
    problems
  end

  def native_problems(spec, contents, dir)
    platform = spec.platform.to_s
    libraries = contents.grep(LIBRARY)
    expected_dir = "#{NATIVE_DIR}/#{platform}/"
    problems = []
    problems << "expected exactly one native library, found #{libraries.size}" unless libraries.size == 1
    problems += libraries.reject { |file| file.start_with?(expected_dir) }.map { |file| "library #{file} is outside #{expected_dir}" }
    problems << "extensions declared" unless spec.extensions.empty?
    problems << "platform gem does not depend on fiddle" unless spec.runtime_dependencies.any? { |d| d.name == "fiddle" }
    problems + manifest_problems(dir, platform, libraries) + provenance_problems(dir, spec, libraries)
  end

  def manifest_problems(dir, platform, libraries)
    manifest = File.join(dir, NATIVE_DIR, "platforms.json")
    return ["missing #{NATIVE_DIR}/platforms.json"] unless File.file?(manifest)

    data = JSON.parse(File.read(manifest))
    problems = []
    problems << "platforms.json platform #{data['platform'].inspect} != #{platform}" unless data["platform"] == platform
    problems << "platforms.json has no abi_version" unless data["abi_version"].is_a?(Integer)
    problems + library_problems(dir, data, platform, libraries)
  rescue JSON::ParserError => e
    ["platforms.json is not valid JSON: #{e.message}"]
  end

  def provenance_problems(dir, spec, libraries)
    file = File.join(dir, NATIVE_DIR, "provenance.json")
    return ["missing #{NATIVE_DIR}/provenance.json"] unless File.file?(file)

    data = JSON.parse(File.read(file))
    missing = PROVENANCE_FIELDS.reject { |key| data[key].is_a?(String) && !data[key].empty? }
    return missing.map { |key| "provenance.json has no #{key}" } unless missing.empty?

    provenance_binding_problems(dir, spec, libraries, data)
  rescue JSON::ParserError => e
    ["provenance.json is not valid JSON: #{e.message}"]
  end

  def provenance_binding_problems(dir, spec, libraries, data)
    problems = []
    problems << "provenance.json platform #{data['platform']} != #{spec.platform}" unless data["platform"] == spec.platform.to_s
    problems << "provenance.json gem_version #{data['gem_version']} != #{spec.version}" unless data["gem_version"] == spec.version.to_s
    problems << "provenance.json revision #{data['revision'].inspect} is not a git sha" unless data["revision"].match?(REVISION)
    problems << "provenance.json revision #{data['revision']} != #{@revision}" if @revision && data["revision"] != @revision
    problems << "provenance.json cargo_lock_sha256 is not a sha256" unless data["cargo_lock_sha256"].match?(SHA256)
    problems + provenance_library_problems(dir, libraries, data)
  end

  def provenance_library_problems(dir, libraries, data)
    return [] unless libraries.size == 1

    actual = Digest::SHA256.file(File.join(dir, libraries.first)).hexdigest
    return [] if data["library_sha256"] == actual

    ["provenance.json library_sha256 #{data['library_sha256']} != actual #{actual}"]
  end

  def library_problems(dir, data, platform, libraries)
    path = "#{NATIVE_DIR}/#{platform}/#{data['library']}"
    return ["platforms.json library #{data['library'].inspect} is not packaged at #{path}"] unless libraries.include?(path)

    actual = Digest::SHA256.file(File.join(dir, path)).hexdigest
    actual == data["sha256"] ? [] : ["sha256 mismatch for #{path}: manifest #{data['sha256']}, actual #{actual}"]
  end
end

options = {}
OptionParser.new do |o|
  o.on("--directory DIR", "directory holding the .gem files") { |v| options[:directory] = v }
  o.on("--revision SHA", "full git revision the source or native provenance must record") { |v| options[:revision] = v }
end.parse!
abort "--directory is required" unless options[:directory]

problems = NativePackageChecker.new(options[:directory], revision: options[:revision]).violations
if problems.empty?
  puts "native package check passed"
else
  warn problems
  exit 1
end
