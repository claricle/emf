#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: script/build_native_gem --platform NAME --output DIR
#          [--library PATH --abi-version N --target TRIPLE] [--revision SHA]
#
# Builds a platform gem (or, with --platform ruby, the source gem) from
# emf.gemspec in a temporary staging tree. The repository is never modified:
# the native library, platforms.json and provenance.json exist only in the
# staging copy. provenance.json records the library hash, Rust target, the
# rustc/cargo found on PATH, the Cargo.lock hash, the crate version, the git
# revision and the gem version.

require "digest"
require "fileutils"
require "json"
require "open3"
require "optparse"
require "rubygems/package"
require "tmpdir"

load File.expand_path("build_source_release_gem", __dir__)

class NativeGemBuilder
  ROOT = File.expand_path("..", __dir__)
  NATIVE_DIR = "lib/emf/native"
  CARGO_LOCK = "emf-rs/Cargo.lock"
  # Default gem on Ruby 3.1-3.4 (1.1.x), bundled gem on 4.0 (1.1.8+).
  FIDDLE_REQUIREMENT = "~> 1.1"
  FFI_MANIFEST = "emf-rs/crates/emf-ffi/Cargo.toml"

  def initialize(platform:, output:, library: nil, abi_version: nil, target: nil, revision: nil)
    @platform = platform
    @output = File.expand_path(output)
    @library = library && File.expand_path(library)
    @abi_version = abi_version
    @target = target
    @revision = revision
  end

  def build
    validate
    return SourceReleaseGemBuilder.new(output: @output, revision: @revision).build if source?

    FileUtils.mkdir_p(@output)
    Dir.mktmpdir("emf-native-gem") { |stage| build_in(stage) }
  end

  private

  def source?
    @platform == "ruby"
  end

  def validate
    abort "--platform ruby builds the source gem and takes no --library" if source? && @library
    return if source?

    abort "--library is required unless --platform is ruby" unless @library
    abort "library not found: #{@library}" unless File.file?(@library)
    abort "--abi-version is required with --library" unless @abi_version
    abort "--target is required with --library" unless @target
  end

  def build_in(stage)
    spec = Dir.chdir(ROOT) { Gem::Specification.load("emf.gemspec") }
    spec.files.each { |file| stage_file(stage, File.join(ROOT, file), file) }
    spec = add_native(stage, spec)
    gem_file = package(stage, spec)
    FileUtils.mv(File.join(stage, gem_file), @output)
    puts File.join(@output, gem_file)
  end

  def add_native(stage, spec)
    name = File.basename(@library)
    relative = File.join(NATIVE_DIR, @platform, name)
    stage_file(stage, @library, relative)
    manifest = write_json(stage, "platforms.json", manifest_data(name))
    provenance = write_json(stage, "provenance.json", provenance_data(spec))
    spec.platform = @platform
    # Ruby 4.0 moved fiddle out of the default gems; the loader requires it, so a platform gem must pull it in.
    spec.add_runtime_dependency "fiddle", FIDDLE_REQUIREMENT
    spec.files += [relative, manifest, provenance]
    spec
  end

  def write_json(stage, name, data)
    relative = File.join(NATIVE_DIR, name)
    File.write(File.join(stage, relative), JSON.pretty_generate(data) << "\n")
    relative
  end

  def manifest_data(name)
    { platform: @platform, library: name, sha256: Digest::SHA256.file(@library).hexdigest,
      abi_version: Integer(@abi_version) }
  end

  def provenance_data(spec)
    { platform: @platform, target: @target, library_sha256: Digest::SHA256.file(@library).hexdigest,
      rustc: tool_version("rustc"), cargo: tool_version("cargo"),
      cargo_lock_sha256: Digest::SHA256.file(File.join(ROOT, CARGO_LOCK)).hexdigest,
      crate_version: crate_version, revision: @revision || git_revision, gem_version: spec.version.to_s }
  end

  def tool_version(tool)
    out, status = Open3.capture2(tool, "--version")
    abort "#{tool} --version failed; provenance needs the build toolchain on PATH" unless status.success?
    out.strip
  end

  def crate_version
    File.read(File.join(ROOT, FFI_MANIFEST))[/^version\s*=\s*"([^"]+)"/, 1] || abort("no version in #{FFI_MANIFEST}")
  end

  def git_revision
    out, status = Open3.capture2("git", "rev-parse", "HEAD", chdir: ROOT)
    abort "git rev-parse HEAD failed; pass --revision" unless status.success?
    out.strip
  end

  def stage_file(stage, source, relative)
    FileUtils.mkdir_p(File.dirname(File.join(stage, relative)))
    FileUtils.cp(source, File.join(stage, relative))
  end

  def package(stage, spec)
    Dir.chdir(stage) do
      Gem::DefaultUserInteraction.use_ui(Gem::SilentUI.new) { Gem::Package.build(spec, true) }
    end
  end
end

options = {}
OptionParser.new do |o|
  o.on("--platform NAME", "gem platform, or ruby for the source gem") { |v| options[:platform] = v }
  o.on("--output DIR", "directory receiving the .gem") { |v| options[:output] = v }
  o.on("--library PATH", "built native library (platform gems)") { |v| options[:library] = v }
  o.on("--abi-version N", "ABI version the library reports") { |v| options[:abi_version] = v }
  o.on("--target TRIPLE", "Rust target triple the library was built for") { |v| options[:target] = v }
  o.on("--revision SHA", "git revision (source gems require checkout match; default: HEAD)") { |v| options[:revision] = v }
end.parse!

abort "--platform and --output are required" unless options[:platform] && options[:output]

NativeGemBuilder.new(**options).build
